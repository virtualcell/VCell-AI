# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# LLM provider  (required)
# ---------------------------------------------------------------------------
# "azure"  -> Azure OpenAI
# "local"  -> any OpenAI-compatible server (e.g. Ollama); see SETUP.md
PROVIDER=azure

# Used directly for knowledge-base EMBEDDINGS. Chat completions go through the
# LiteLLM gateway instead (see below), but these keys must still be valid for
# the knowledge base and the summary generator to work.
# For PROVIDER=local, point AZURE_ENDPOINT at the local server and set the two
# model names to models it serves.
AZURE_API_VERSION=your_api_version
AZURE_ENDPOINT=https://your-azure-openai.openai.azure.com
AZURE_API_KEY=your_azure_api_key
AZURE_DEPLOYMENT_NAME=your_chat_deployment_name
AZURE_EMBEDDING_DEPLOYMENT_NAME=your_embedding_deployment_name

# ---------------------------------------------------------------------------
# Qdrant — vector store for the knowledge base  (required)
# ---------------------------------------------------------------------------
# Inside docker compose this is http://qdrant:6333; from the host, localhost.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=your_collection_name

# ---------------------------------------------------------------------------
# Langfuse — LLM observability  (required)
# ---------------------------------------------------------------------------
# Langfuse Cloud, or the self-hosted instance in the langfuse/ submodule.
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_HOST=https://cloud.langfuse.com

# ---------------------------------------------------------------------------
# Auth0 — token verification
# ---------------------------------------------------------------------------
# Optional to boot, but every authenticated route fails without them. The
# audience must match AUTH0_AUDIENCE in frontend/.env, or tokens are rejected.
AUTH0_DOMAIN=your_auth0_domain
AUTH0_AUDIENCE=your_auth0_api_identifier

# ---------------------------------------------------------------------------
# Supabase — users, roles, gateway keys, summaries, publications
# ---------------------------------------------------------------------------
# Optional to boot, but login, budgets and precomputed data need them.
# Use the SERVICE ROLE key: the backend is trusted and bypasses row-level
# security. Never expose this key to the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ---------------------------------------------------------------------------
# LiteLLM gateway — all chat completions
# ---------------------------------------------------------------------------
# Inside docker compose this is http://litellm:4000; from the host, localhost.
LITELLM_URL=http://litellm:4000

# Must match LITELLM_MASTER_KEY in litellm.env. The backend uses it to
# provision each user's virtual key and to read their spend.
LITELLM_MASTER_KEY=sk-litellm-change-me

# Spend allowance granted to a new user, and how often it renews.
DEFAULT_USER_BUDGET=2.00
DEFAULT_BUDGET_DURATION=30d
