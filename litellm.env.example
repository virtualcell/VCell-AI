# ===========================================================================
# LiteLLM gateway
#
# Every chat completion in the platform goes through this proxy, which owns
# per-user virtual keys, spending budgets, model routing and fallback.
#
# Which variables are read depends on the config the proxy is started with:
#   - litellm_config.yaml                  (docker compose) -> hosted OpenAI
#   - kustomize/base/litellm_config.yaml   (Kubernetes)     -> Azure and/or OpenAI
# Variables only the Kubernetes config uses are marked below.
# ===========================================================================

# ---------------------------------------------------------------------------
# Gateway  (required)
# ---------------------------------------------------------------------------
# Admin key for the proxy. Must match LITELLM_MASTER_KEY in backend/.env.
# Generate one with:  openssl rand -hex 32
LITELLM_MASTER_KEY=sk-litellm-change-me

# Postgres connection used to persist users, virtual keys and spend/budget
# tracking. Without it, keys and budgets are lost on every container restart.
# Supabase works: use the direct connection or session pooler URL (port 5432).
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require

# ---------------------------------------------------------------------------
# "openai-model" alias — the hosted model the app requests by default
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=openai/gpt-4o-mini

# Kubernetes config only: a second, interchangeable backend for the same alias.
# Supply either provider or both; the gateway routes to whichever authenticates
# and cools down one that fails.
# NOTE: knowledge-base embeddings still call Azure directly from the backend, so
# the RAG features need an Azure key regardless of what is set here.
AZURE_MODEL=azure/your-chat-deployment-name
AZURE_ENDPOINT=https://your-azure-openai.openai.azure.com
AZURE_API_KEY=your_azure_openai_api_key
AZURE_API_VERSION=2024-02-01

# ---------------------------------------------------------------------------
# "local-model" alias — locally hosted model  (required)
# ---------------------------------------------------------------------------
# Serves two purposes: a privacy-preserving option users can pick per message,
# and the automatic fallback when a user's budget is exhausted or the hosted
# provider fails. Keep the "ollama/" prefix when using Ollama.
LOCAL_LLM_MODEL=ollama/phi4-mini
# From a container, the host's Ollama is reachable at host.docker.internal.
LOCAL_LLM_API_BASE=http://host.docker.internal:11434

# ---------------------------------------------------------------------------
# Langfuse tracing callback  (required)
# ---------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com

# ---------------------------------------------------------------------------
# Reverse-proxy settings  (optional — only when exposed under a path prefix)
# ---------------------------------------------------------------------------
# Tells the proxy the URL prefix it is served under, so it builds prefix-aware
# URLs and its admin dashboard does not redirect outside the prefix. Leave unset
# when the proxy is reached directly, as it is in docker compose.
# SERVER_ROOT_PATH=/your-prefix

# Trust X-Forwarded-Proto from the ingress so generated URLs use https. Only
# safe when the proxy is not directly reachable from outside the cluster.
# FORWARDED_ALLOW_IPS=*
