# ---------------------------------------------------------------------------
# Backend API
# ---------------------------------------------------------------------------
# Base URL the browser uses to reach the backend. Read at BUILD time, so it must
# be set before `next build`, not only at runtime.
#   - local dev / docker compose : absolute URL (frontend and backend are on
#                                  different ports, with no proxy between them)
#   - behind an ingress          : relative "/api", so one image works anywhere
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Auth0 (all required — the app cannot sign anyone in without these)
# ---------------------------------------------------------------------------
# Public base URL of THIS application. Must match the callback and logout URLs
# configured on the Auth0 application.
APP_BASE_URL=http://localhost:3000

# Secret used to encrypt the session cookie. Generate one with:
#   openssl rand -hex 32
AUTH0_SECRET=your_generated_session_secret

# Auth0 tenant domain, without a scheme (e.g. your-tenant.us.auth0.com).
AUTH0_DOMAIN=your_auth0_domain

# Credentials of the Auth0 "Regular Web Application" used by this frontend.
AUTH0_CLIENT_ID=your_auth0_client_id
AUTH0_CLIENT_SECRET=your_auth0_client_secret

# Identifier of the Auth0 API the backend validates against. Without it, Auth0
# issues an opaque token the backend will reject — set it to the same value as
# AUTH0_AUDIENCE in backend/.env.
AUTH0_AUDIENCE=your_auth0_api_identifier
